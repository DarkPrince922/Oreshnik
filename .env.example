# ─── Oreshnik environment ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
ORESHNIK_ENV=dev
# 32-byte url-safe base64 key for encrypting user secrets (LLM/SSH keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key
# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_random_hex
JWT_EXPIRE_MINUTES=720

# --- First-run admin (created only when the users table is empty) ---
# Leave ADMIN_PASSWORD empty to get a random one printed ONCE in the backend log:
#   docker compose logs backend | grep "initial admin"
ADMIN_EMAIL=admin@oreshnik.dev
ADMIN_PASSWORD=

# --- Login throttling (failed attempts per email+IP within the window) ---
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900

# --- Database (Postgres) ---
POSTGRES_USER=oreshnik
POSTGRES_PASSWORD=oreshnik
POSTGRES_DB=oreshnik
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Celery broker + log pub/sub) ---
REDIS_URL=redis://redis:6379/0

# --- Runner / Strix ---
# Directory on the host where scan artifacts (strix_runs/<id>) are written.
STRIX_RUNS_DIR=/data/strix_runs
# Default runner: "mock" (no tokens burned) or "local" (real strix + docker).
DEFAULT_RUNNER=mock

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
