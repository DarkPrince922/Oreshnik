# ─── Oreshnik environment ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
ORESHNIK_ENV=dev
# 32-byte url-safe base64 key for encrypting user secrets (LLM/SSH keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key
# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_random_hex
JWT_EXPIRE_MINUTES=720

# --- First-run admin (created only when the users table is empty) ---
# Leave ADMIN_PASSWORD empty to get a random one printed ONCE in the backend log:
#   docker compose logs backend | grep "initial admin"
ADMIN_EMAIL=admin@oreshnik.dev
ADMIN_PASSWORD=

# --- Login throttling (failed attempts per email+IP within the window) ---
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900

# --- Database (Postgres) ---
POSTGRES_USER=oreshnik
POSTGRES_PASSWORD=oreshnik
POSTGRES_DB=oreshnik
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Celery broker + log pub/sub) ---
REDIS_URL=redis://redis:6379/0

# --- Runner / Strix ---
# Directory on the host where scan artifacts (strix_runs/<id>) are written.
STRIX_RUNS_DIR=/data/strix_runs
# Default runner: "mock" (no tokens burned) or "local" (real strix + docker).
DEFAULT_RUNNER=mock
# Path/name of the Strix executable inside the worker image.
STRIX_BIN=strix
# Parallel scans per worker (each one = a Strix run + sandbox containers + LLM spend).
SCAN_CONCURRENCY=2
# Safety nets (Strix's own per-scan --max-budget is the primary spend limit):
MAX_ACTIVE_SCANS_PER_USER=3     # queued+running scans one user may have on ONE runner (a runner can set its own number)
SCAN_TIMEOUT_MINUTES=180        # wall-clock limit per scan, 0 = off
SCAN_STALE_SECONDS=180          # a running scan without worker heartbeat this long is marked failed
STRIX_CANCEL_GRACE_SECONDS=20   # SIGINT -> SIGTERM -> SIGKILL escalation step on cancel
# Pace of the simulated runner, seconds per line.
MOCK_DELAY_SECONDS=0.35

# --- Scheduling ---
# A schedule on a real (paid) runner must carry a budget limit and may not fire more often than this (minutes).
# The simulated runner is exempt. Schedules are fired by celery beat, which must be running.
SCHEDULE_MIN_INTERVAL_MINUTES=15
MAX_SCHEDULES_PER_USER=20

# --- What Strix may send out by itself (both off by default) ---
# Strix's anonymous telemetry (PostHog/Scarf: model name, finding severities and CWEs, duration, cost, ...).
STRIX_TELEMETRY=false
# Strix's daily "is a newer version available?" request to PyPI (the panel pins the Strix version on purpose).
STRIX_UPDATE_CHECK=false

# --- How hard each model call thinks (cost/speed vs thoroughness) ---
# none|minimal|low|medium|high|xhigh|max. "high" is Strix's own default, so this default changes nothing.
# Only takes effect for a model LiteLLM's own catalog marks as reasoning-capable (today: Claude, GPT-5 and similar —
# not Grok or most self-hosted "custom" models); Strix silently ignores it for everything else.
STRIX_REASONING_EFFORT=high
# How long Strix waits for the model to answer its one tiny test request before a scan starts (seconds, 1-600).
# Raise it for a slow gateway or a model that thinks long before its first token. It does not help when the
# RUNNER cannot reach the endpoint at all — the panel and the runner are different machines.
LLM_PREFLIGHT_TIMEOUT=30

# «Операции»: how long one host's LLM-written script may run before it is given up on and marked failed (seconds).
OPS_HOST_TIMEOUT_SECONDS=600

# --- SSH runners ---
SSH_CONNECT_TIMEOUT_SECONDS=15
# How often the worker re-checks that confirmed SSH hosts are reachable and ready (0 = off).
SSH_CHECK_INTERVAL_SECONDS=120
# While a remote scan runs, its run files are mirrored to the panel this often (live cost, agent feed).
SSH_SYNC_INTERVAL_SECONDS=2.0
# Upper bounds for what is fetched back from a remote run directory.
SSH_FETCH_MAX_MB=500
SSH_FETCH_MAX_FILES=20000
# What "Установить" puts on a remote host; the panel was verified against these versions.
STRIX_VERSION=1.7.0
STRIX_SANDBOX_IMAGE=ghcr.io/usestrix/strix-sandbox:1.3.0

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
